<?xml version="1.0" encoding="utf-8"?>
<!-- Settings and saves live in the WebView's local storage; exclude them from
     cloud backups so a player's match history stays on the device. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
    </cloud-backup>
    <device-transfer>
        <include domain="root" />
    </device-transfer>
</data-extraction-rules>
