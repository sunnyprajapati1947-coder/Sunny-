<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Base application theme: dark, edge-to-edge, no action bar. -->
    <style name="AppTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="colorPrimary">@color/brandGold</item>
        <item name="colorPrimaryDark">@color/brandNight</item>
        <item name="colorAccent">@color/brandGold</item>
        <item name="android:windowBackground">@color/brandNight</item>
        <item name="android:statusBarColor">@color/brandNight</item>
        <item name="android:navigationBarColor">@color/brandNight</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="AppTheme">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
    </style>

    <!-- Launch splash: brand background behind the generated crest artwork. -->
    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="android:background">@drawable/splash</item>
        <item name="windowSplashScreenBackground">@color/brandNight</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
    </style>
</resources>
