{
  "id": "./",
  "name": "ECC Pocket — agent harness reader",
  "short_name": "ECC Pocket",
  "description": "Every ECC skill, agent, command and rule — searchable and readable on any phone, online or offline.",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": ["standalone", "minimal-ui"],
  "orientation": "any",
  "background_color": "#0b0d10",
  "theme_color": "#0b0d10",
  "lang": "en",
