    },
    {
      "name": "Skills",
      "short_name": "Skills",
      "url": "./#/browse/skill",
      "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Install ECC",
      "short_name": "Install",
      "url": "./#/install",
      "icons": [{ "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    }
  ]
