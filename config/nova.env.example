# Optional Google Gemini online model. Keep this file private; never commit a real key.
# Set GEMINI_API_KEY in your local shell or in config/nova.env (gitignored).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# auto = Gemini first when a key is configured, then local Qwen fallback.
# local = use only local Qwen. gemini = try Gemini first, then local fallback.
NOVA_LLM_PROVIDER=auto
GEMINI_TIMEOUT=25
