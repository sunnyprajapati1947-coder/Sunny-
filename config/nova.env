NOVA_NAME=Nova
NOVA_OWNER=Boss

NOVA_LOCAL_FIRST=true
NOVA_CLOUD_API_REQUIRED=false

NOVA_QWEN_URL=http://127.0.0.1:8080/v1/chat/completions
NOVA_QWEN_MODEL=Qwen3.5-4B-Q4_0

NOVA_MAX_PLAN_STEPS=6
NOVA_MAX_REPAIR_ATTEMPTS=2

NOVA_REQUIRE_APPROVAL_FOR_HIGH_IMPACT=true
NOVA_BLOCK_DESTRUCTIVE_COMMANDS=true
NOVA_BLOCK_SECRET_EXPOSURE=true
NOVA_BLOCK_AUTOMATIC_FINANCIAL_EXECUTION=true

NOVA_VIDEO_ENABLED=true
NOVA_YOUTUBE_ENABLED=true
NOVA_YOUTUBE_ROOT=~/Nova/youtube
NOVA_YOUTUBE_CLIENT_SECRET=~/Nova/youtube/client_secret.json
NOVA_YOUTUBE_TOKEN=~/Nova/youtube/token.json
NOVA_YOUTUBE_DEFAULT_PRIVACY=private
NOVA_MARKET_RESEARCH_ENABLED=true
NOVA_BROWSER_ENABLED=true
NOVA_PHONE_ENABLED=true
NOVA_MEMORY_ENABLED=true

NOVA_CHROME_UI_ENABLED=false

NOVA_SELF_HEAL_ENABLED=true
NOVA_SELF_HEAL_MAX_RESTARTS=3
NOVA_QWEN_MODEL_PATH=~/models/Qwen3.5-4B-Q4_0.gguf
NOVA_WATCHDOG_INTERVAL=60
