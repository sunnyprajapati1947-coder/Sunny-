# J.A.R.V.I.S. configuration — safe defaults, no secrets in this file.
# Real secrets belong in your shell environment (e.g. GEMINI_API_KEY).

JARVIS_OWNER=Sir
JARVIS_CITY=Patna
JARVIS_COUNTRY_CODE=+91
JARVIS_LANGUAGE=en-IN
JARVIS_WAKE_WORD=jarvis
# Hands-free listening (browser SpeechRecognition): arm with the mic button or this flag.
JARVIS_WAKE_WORD_ENABLED=false
# Talk over a reply to interrupt it (barge-in).
JARVIS_BARGE_IN=true

JARVIS_HOST=0.0.0.0
JARVIS_PORT=7777

# Neural brain. Offline mode works without any of these.
# export GEMINI_API_KEY=...      # enables reasoning + vision
JARVIS_LLM_ENABLED=true
JARVIS_LLM_TOOLS=true
JARVIS_GEMINI_MODEL=gemini-2.5-flash
JARVIS_QWEN_URL=http://127.0.0.1:8080/v1/chat/completions
JARVIS_QWEN_MODEL=qwen2.5:7b-instruct
JARVIS_FAST_QWEN_URL=http://127.0.0.1:8081/v1/chat/completions
JARVIS_FAST_QWEN_MODEL=qwen3:4b
JARVIS_CODER_QWEN_URL=http://127.0.0.1:8080/v1/chat/completions
JARVIS_CODER_QWEN_MODEL=qwen2.5-coder:7b

# Brain routing: auto | local | gemini | offline
# auto = Gemini when a key exists, then local Qwen, then the offline core.
JARVIS_BRAIN_MODE=auto

# Multi-step agent (plans live in data/jarvis/plans)
JARVIS_AGENT_ENABLED=true
JARVIS_AGENT_STEPS=5

# Focus mode: short, numbered, one next action.
JARVIS_ADHD_MODE=false

# Real email sending (optional). Gmail needs an app password.
# JARVIS_SMTP_HOST=smtp.gmail.com
# JARVIS_SMTP_PORT=587
# JARVIS_SMTP_USER=you@gmail.com
# JARVIS_SMTP_PASSWORD=app-password-here
# JARVIS_SMTP_FROM=you@gmail.com
# JARVIS_SMTP_TLS=true

# Desktop control starts disarmed; arm it from the HUD or with "arm desktop control".

# ---------------------------------------------------------------- free AI routes
# Two self-hosted OpenAI-compatible gateways pool free model tiers:
#   FreeLLMAPI  → docker run -p 3001:3001 ghcr.io/freellmapi/freellmapi:latest
#   OmniRoute   → npm install -g omniroute && omniroute     (port 20128)
# Jarvis talks to both automatically; add the keys only if the gateway asks for one.
# JARVIS_FREELLMAPI_KEY=freellmapi-your-unified-key
# JARVIS_OMNIROUTE_KEY=any-string
# Any other OpenAI-compatible endpoint:
#   "add route mybox at http://192.168.1.20:3001/v1"   (or JARVIS_ROUTE_MYBOX_KEY=...)
#
# No key, no install? The keyless lane (public OpenAI-compatible endpoint) is on
# by default. It is best effort; JARVIS_KEYLESS=0 turns it off.
# JARVIS_KEYLESS=1
# JARVIS_KEYLESS_URL=https://text.pollinations.ai/openai
# JARVIS_KEYLESS_MODEL=openai-fast
#
# Brain order: auto = Gemini → local Qwen → free routes → keyless → offline core.
# "use free models" switches to routes first.
# JARVIS_BRAIN_MODE=auto

# Local media + networking
JARVIS_MUSIC_DIR=~/Music
JARVIS_HTTP_TIMEOUT=9
JARVIS_SPEEDTEST_URL=https://speed.cloudflare.com/__down?bytes=5000000
