# Supabase cloud sync (optional)
# Copy this file to .env.local and fill in your project values, then restart `npm run dev`.
# Without these the app still works fully offline — every row lives in IndexedDB on the
# device and More → Download backup keeps a copy.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Tip: you can also connect the cloud from inside the installed app
# (More → Connect cloud). That value is stored on the device and takes priority over
# this file, which is handy for an APK that is already installed.
